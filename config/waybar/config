// modules docs: https://github.com/Alexays/Waybar/wiki/Modules

// to reload the config:
// killall waybar; waybar &
// ... or ...
// killall -SIGUSR2 waybar

// using https://github.com/d00m1k/SimpleBlueColorWaybar/ as inspiration...
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 2,
    "margin-top": 0,
    "margin-bottom": 0,

    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
    ],

    "modules-center": [
        "clock#date",
        "clock#time"
    ],

    "modules-right": [
        "custom/language",
        "pulseaudio",
        "network",
        // Disabled until Waybar includes the removable-battery crash fix.
        "power-profiles-daemon"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon} {name}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },

    // The clock is split into two modules so it reads as a pair of segments,
    // the same shape as the tmux status bar: an ambient block followed by a
    // filled, bold block.
    "clock#date": {
        "format": "{:%a %Y-%m-%d}",
        "timezone": "",
        "interval": 60,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#88c0d0'><b>{}</b></span>",
                "weekdays": "<span color='#5e81ac'><b>{}</b></span>",
                "days":     "<span color='#d8dee9'>{}</span>",
                "today":    "<span color='#88c0d0'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "clock#time": {
        "format": "{:%T}",
        "timezone": "",
        "interval": 1,
        "tooltip": false
    },

    // English <-> Japanese (Mozc) via fcitx5. Super+space toggles it globally;
    // clicking the module does the same thing.
    "custom/language": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/language.sh",
        "interval": 1,
        "on-click": "fcitx5-remote -t"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%  {format_source}",
        "format-bluetooth-muted": "  {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "  {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },


    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " Connected",
        "tooltip-format": "{ifname}  ::  {ipaddr}/{cidr}\ngateway {gwaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "⚠ Offline",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "{profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
}
